APP_NAME="WhatsUP Campaign Manager"
APP_URL=http://localhost/WhatsUP
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=UTC
SESSION_SECURE=false
APP_KEY=replace-with-at-least-32-random-bytes
DB_DSN="mysql:host=127.0.0.1;dbname=whatsup;charset=utf8mb4"
DB_USER=whatsup_app
DB_PASSWORD=change-this-password
DEFAULT_REGION=GH
MAX_UPLOAD_BYTES=15728640
DAILY_QUOTA=1000
ACCESS_CODE_PEPPER=replace-with-independent-random-secret
WEBHOOK_URL=https://example.invalid/whatsapp
WEBHOOK_SECRET=replace-with-independent-webhook-secret
WEBHOOK_ALLOW_HTTP_LOCAL=false
CALLBACK_SECRET=replace-with-independent-callback-secret
CALLBACK_MAX_AGE_SECONDS=300
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=6
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
