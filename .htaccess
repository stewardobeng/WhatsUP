Options -Indexes
DirectoryIndex public/index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|storage|database|scripts|tests|config)(/|$) - [F,L]
  RewriteRule ^assets/(.*)$ public/assets/$1 [L]
  RewriteRule ^public/ - [L]
  RewriteRule ^ public/index.php [L]
</IfModule>
<FilesMatch "^(\.env.*|\.gitignore|\.git.*|README\.md|composer\.(json|lock)|.*\.sql|.*\.log|.*\.md)$">
  Require all denied
</FilesMatch>
